# Server-only MiniMax configuration. Never prefix the API key with VITE_.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# The Agent requires MiniMax. If the provider is unavailable, Relay preserves
# the original input and offers retry; it never substitutes a simplified plan.
