# Server-only MiniMax configuration. Never prefix the API key with VITE_.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7

# auto: use MiniMax when a key exists, otherwise labelled local fallback.
# fallback: always use the deterministic local demo engine.
RELAY_AGENT_MODE=auto
